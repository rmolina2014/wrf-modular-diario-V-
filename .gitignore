# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/

# Entornos y secretos
.env
.venv
venv/
VENV/

# Logs (se versionan los copiados en outputs/<caso>/logs/)
/logs/
wps_sanjuan/*.log

# Runtime de WPS (symlinks/copias generadas por run_wps_diario.sh)
wps_sanjuan/*.exe
wps_sanjuan/GEOGRID.TBL
wps_sanjuan/METGRID.TBL
wps_sanjuan/Vtable
wps_sanjuan/link_grib.csh
wps_sanjuan/namelist.wps

# SO
.DS_Store
Thumbs.db

# WRF / intermediarios grandes
*.nc
wrfout*
rsl.*
met_em.*
geo_em*
FILE:*
GRIBFILE.*

# Datos descargados (se versiona el crudo de obs; el GFS pesa GBs)
data/*
!data/raw/
wps_sanjuan/gfs_data/
wps_sanjuan/FILE:*
wps_sanjuan/GRIBFILE.*

# Directorio de corrida WRF (symlinks a wrf.exe/real.exe + archivos de la corrida)
run_wrf/

# Productos de salida: se versionan informes, valores (CSV) y productos.
# Los wrfout/intermediarios .nc quedan excluidos por *.nc y wrfout*.
# Ventana de observaciones fusionada (intermedio de una corrida)
data/raw/*_ventana.csv
