[Unit]
Description=Pronóstico diario WRF con asimilación de observaciones (San Juan)
Documentation=https://github.com/rmolina2014/wrf-modular-diario-V
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgich
WorkingDirectory=/home/pgich/wrf-modular-diario-V-
# La fecha del ciclo la resuelve run_diario.sh (date -u: hoy UTC). Para una corrida
# manual de otra fecha: run_diario.sh --fecha YYYY-MM-DD
ExecStart=/home/pgich/wrf-modular-diario-V-/run_diario.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=21600

# Etapa 2 de automatización: descomentar cuando se valide el modo manual.
# La hora debe ser posterior a t0 (18Z con los defaults: ciclo 06Z + 12 h de asimilación)
# para que las observaciones de la ventana ya estén disponibles.
# Calendar=*-*-* 19:30:00