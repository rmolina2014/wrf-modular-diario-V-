[Unit]
Description=Dispara el ciclo WRF 12Z (t0 00Z del día siguiente, objetivo día local siguiente)

[Timer]
# 01:30 UTC = 22:30 ART: 1,5 h después de t0 (00Z del día siguiente).
# run_ciclo.sh detecta que el ciclo es de la fecha anterior.
OnCalendar=*-*-* 01:30:00 UTC
Persistent=true
Unit=wrf-diario@12.service

[Install]
WantedBy=timers.target
