[Unit]
Description=Disparador diario del pronóstico WRF (San Juan)
RefuseManualStart=no

[Timer]
# Etapa 2 de automatización: debe disparar después de t0 (18Z con los defaults: ciclo 06Z
# + 12 h de asimilación) para que las observaciones de la ventana estén disponibles.
# 19:30 UTC = 16:30 ART (America/Argentina/San_Juan, UTC-3).
OnCalendar=*-*-* 19:30:00
Persistent=true
Unit=wrf-diario.service

[Install]
WantedBy=timers.target