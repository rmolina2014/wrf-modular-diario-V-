# Configuración de wrf-modular-diario.
# Copiar a `.env` y completar. Las claves NO se suben al repositorio.

# ---- Credenciales EcoWitt (API v3) ----
ECOWITT_APP_KEY=TU_APPLICATION_KEY
ECOWITT_API_KEY=TU_API_KEY
# ECOHUMUS usa claves propias (opcional si la estación está en el catálogo)
ECOWITT_APP_KEY_ECOHUMUS=
ECOWITT_API_KEY_ECOHUMUS=

# ---- Rutas WRF local (PC pgich) ----
LOCAL_WRF_DIR=/home/pgich/wrf-modular-diario-V-/run_wrf
WRF_ENV_BASH=/home/pgich/wrf-operativo/ejecutables/env.bash
WRF_BASE=/home/pgich/Build_WRF
WPS_DIR=/home/pgich/Build_WRF/WPS
WRF_EJECUTABLES=/home/pgich/wrf-operativo/ejecutables
GEOG_DATA_PATH=/home/pgich/wrf-operativo/datos/WPS_GEOG
MPIRUN=/home/pgich/Build_WRF/libraries/MPICH/bin/mpirun
WRF_NP=1
VALIDATION_PYTHON=/home/pgich/anaconda3/envs/wrf-operativo-p3/bin/python

# ---- Protocolo temporal (opcional; estos son los valores por defecto) ----
# El modelo arranca en el ciclo GFS CICLO_GFS, asimila ASIM_HOURS horas (hasta t0) y pronostica
# libre hasta el fin del día local siguiente. HUSO_LOCAL_H: huso de ese día (San Juan = -3).
# CICLO_GFS=06
# ASIM_HOURS=12
# HUSO_LOCAL_H=-3

# ---- Estaciones a asimilar (opcional) ----
# Una estación solo se asimila si aporta al menos esta fracción de los registros esperables
# en la ventana [inicio, t0] (cadencia de EcoWitt en minutos).
# OBS_MIN_COBERTURA_ESTACION=0.5
# OBS_CADENCIA_MIN=5

# ---- GFS y disco ----
# 0p50 (~150 MB/archivo) para los 4 ciclos; 0p25 (~500 MB) para sensibilidad.
GFS_RES=0p50
# El GFS se borra tras generar met_em; KEEP_GFS=1 lo conserva para depurar.
KEEP_GFS=0
