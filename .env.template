# Configuración de wrf-modular-diario.
# Copiar a `.env` y completar. Las claves NO se suben al repositorio.

# ---- Credenciales EcoWitt (API v3) ----
ECOWITT_APP_KEY=TU_APPLICATION_KEY
ECOWITT_API_KEY=TU_API_KEY
# ECOHUMUS usa claves propias (opcional si la estación está en el catálogo)
ECOWITT_APP_KEY_ECOHUMUS=
ECOWITT_API_KEY_ECOHUMUS=

# ---- Rutas WRF local (PC roberto) ----
LOCAL_WRF_DIR=/home/roberto/opencode/wrf/WRF-4.5/run
WRF_ENV_BASH=/home/roberto/opencode/wrf/WRF-4.5/run/env.bash
WRF_BASE=/home/roberto/opencode/wrf
WPS_DIR=/home/roberto/opencode/wrf/WPS-4.5
WRF_EJECUTABLES=/home/roberto/opencode/wrf/WRF-4.5
GEOG_DATA_PATH=/home/roberto/opencode/wrf/geog/WPS_GEOG_LOW_RES
MPIRUN=/usr/bin/mpirun
WRF_NP=1
VALIDATION_PYTHON=/usr/bin/python3